{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "pixi-svelte": [
        "./src/vendor/pixi-svelte/index.ts"
      ],
      "pixi-svelte/*": [
        "./src/vendor/pixi-svelte/*"
      ],
      "spine-svelte": [
        "./src/vendor/spine-svelte/index.ts"
      ],
      "spine-svelte/components": [
        "./src/vendor/spine-svelte/src/lib/components/index.ts"
      ],
      "spine-svelte/dev": [
        "./src/vendor/spine-svelte/src/lib/dev/index.ts"
      ],
      "spine-svelte/state": [
        "./src/vendor/spine-svelte/src/lib/state/index.ts"
      ],
      "spine-svelte/*": [
        "./src/vendor/spine-svelte/*"
      ]
    },
    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src"
  ],
  /*
   * Svelte-owned sources are type-checked by `pnpm check:svelte`, not tsc: plain tsc resolves
   * `.svelte` through an opaque ambient shim, so modules re-exporting named types from a
   * component (e.g. pixi-svelte's components/index.ts) can't compile here.
   */
  "exclude": [
    "src/vendor/pixi-svelte",
    "src/vendor/spine-svelte"
  ]
}
